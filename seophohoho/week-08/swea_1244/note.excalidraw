      "updated": 1790752846006,
      "link": null,
      "locked": false,
      "text": "② 한 회차씩 전부 펼친다",
      "fontSize": 100,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "② 한 회차씩 전부 펼친다",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1i"
    },
    {
      "id": "XkM40Y1R0A292Xjf2S0NH",
      "type": "text",
      "x": 2810,
      "y": 3980,
      "width": 1848,
      "height": 75,
