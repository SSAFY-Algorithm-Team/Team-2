      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "결론: 무효 전이(no-op transition) — 상태는 그대로, 횟수만 소모하는 이동 — 가 \"정확히 k번\n교환\"이라는 제약 조건(constraint)을 깬다",
      "fontSize": 52,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "결론: 무효 전이(no-op transition) — 상태는 그대로, 횟수만 소모하는 이동 — 가 \"정확히 k번\n교환\"이라는 제약 조건(constraint)을 깬다",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAP"
    }
