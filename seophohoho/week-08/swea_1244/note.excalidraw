    {
      "id": "ytgCwl753hOJg5jKe7dF6",
      "type": "text",
      "x": 2840,
      "y": 13860,
      "width": 1250,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
