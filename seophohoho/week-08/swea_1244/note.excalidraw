      "isDeleted": false,
      "boundElements": [],
      "updated": 1790752846006,
      "link": null,
      "locked": false,
      "text": "BFS(너비 우선 탐색) — 한 층을 전부 본 뒤에 다음 층으로 간다",
      "fontSize": 60,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BFS(너비 우선 탐색) — 한 층을 전부 본 뒤에 다음 층으로 간다",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1j"
    },
