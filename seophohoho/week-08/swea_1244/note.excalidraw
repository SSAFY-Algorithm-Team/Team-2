      "link": null,
      "locked": false,
      "text": "• j를 i + 1부터 시작하면 두 가지가 한 번에 사라진다",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• j를 i + 1부터 시작하면 두 가지가 한 번에 사라진다",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAO"
    },
    {
