      "roundness": null,
      "seed": 1001074661,
      "version": 2,
      "versionNonce": 1461375535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "발표 스크립트 — 123, 2번",
      "fontSize": 160,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "발표 스크립트 — 123, 2번",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5j"
    },
    {
      "id": "4skqiQFU8OChFTSPNcPEf",
      "type": "text",
      "x": -280,
      "y": 8700,
      "width": 2628,
      "height": 75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 861082515,
      "version": 2,
      "versionNonce": 1515580481,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "S1 → S11 순서로 넘긴다. 파란 글씨 = 말할 것, 주황 = 뉘앙스, 회색 = 속으로 챙길 것",
      "fontSize": 60,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S1 → S11 순서로 넘긴다. 파란 글씨 = 말할 것, 주황 = 뉘앙스, 회색 = 속으로 챙길 것",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5k"
    },
