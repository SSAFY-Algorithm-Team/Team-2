    },
    {
      "id": "HjBa-ac9dC6YrnJLMXkd_",
      "type": "text",
      "x": 14890,
      "y": 4580,
      "width": 1598.7999999999995,
      "height": 140,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
