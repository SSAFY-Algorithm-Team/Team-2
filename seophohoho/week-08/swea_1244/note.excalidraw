      "lineHeight": 1.25,
      "index": "b4m"
    },
    {
      "id": "uMV5VMNJt15TASD7rq8gm",
      "type": "text",
      "x": 5830,
      "y": 6360,
      "width": 1632.8,
      "height": 65,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
