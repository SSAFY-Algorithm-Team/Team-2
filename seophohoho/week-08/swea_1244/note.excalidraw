      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "• \"3가지 교환을 전부 해봅니다.\"",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• \"3가지 교환을 전부 해봅니다.\"",
