    {
      "id": "2S7LikqB9jymxaxmGAnju",
      "type": "text",
      "x": 8880,
      "y": 10029.5,
      "width": 2438,
      "height": 115,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
