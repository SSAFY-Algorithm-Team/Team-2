    {
      "id": "5Rf3S741rciSMMIkn1TTY",
      "type": "text",
      "x": 13170,
      "y": 7010,
      "width": 952.8,
      "height": 240,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
