      "locked": false,
      "index": "b6K"
    },
    {
      "id": "4iTo4J3XcswyEVp8OA7UM",
      "type": "text",
      "x": 5830,
      "y": 9000,
      "width": 1632,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 318851974,
      "version": 2,
      "versionNonce": 1591258767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "S3. 한 번 바꾸는 방법은 몇 가지?",
      "fontSize": 96,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3. 한 번 바꾸는 방법은 몇 가지?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6L"
    },
    {
      "id": "UAc7ateZJl3LrNL7amhOt",
      "type": "text",
      "x": 5830,
      "y": 9170,
      "width": 201.6,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1764356248,
      "version": 2,
      "versionNonce": 456820193,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "말할 것",
      "fontSize": 56,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "말할 것",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6M"
    },
    {
      "id": "FZ7pJtjWV154eDO0MUVgg",
      "type": "text",
      "x": 5860,
      "y": 9260,
      "width": 2100,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1999334598,
      "version": 2,
      "versionNonce": 805438639,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "• \"카드가 3장이면 두 장을 고르는 방법은 1↔2, 1↔3, 2↔3, 이렇게 3가지입니다.\"",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• \"카드가 3장이면 두 장을 고르는 방법은 1↔2, 1↔3, 2↔3, 이렇게 3가지입니다.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6N"
    },
    {
      "id": "swHr04tMrIjVLOENdXT40",
      "type": "text",
      "x": 5860,
      "y": 9336.5,
      "width": 1270,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1584490586,
      "version": 2,
      "versionNonce": 1284579777,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "• \"1↔3과 3↔1은 같은 교환이라 한 번만 셉니다.\"",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• \"1↔3과 3↔1은 같은 교환이라 한 번만 셉니다.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6O"
    },
    {
      "id": "8t4Y1Hv7EDJncu3gqEPly",
      "type": "text",
      "x": 5860,
      "y": 9413,
      "width": 2030,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1472147580,
      "version": 2,
      "versionNonce": 1507563215,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "• \"이걸 조합(combination)이라고 합니다. 순서 없이 몇 개를 고르는 것입니다.\"",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• \"이걸 조합(combination)이라고 합니다. 순서 없이 몇 개를 고르는 것입니다.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6P"
    },
    {
      "id": "f6oNsCkUiDT3MvQpasqvj",
      "type": "text",
      "x": 5860,
      "y": 9489.5,
      "width": 1740,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1153873508,
      "version": 2,
      "versionNonce": 1953055137,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "• \"공식은 n × (n−1) ÷ 2. 3장이면 3가지, 6장이면 15가지입니다.\"",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• \"공식은 n × (n−1) ÷ 2. 3장이면 3가지, 6장이면 15가지입니다.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6Q"
    },
