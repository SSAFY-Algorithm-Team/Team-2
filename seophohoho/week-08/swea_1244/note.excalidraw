      "isDeleted": false,
      "boundElements": [],
      "updated": 1790758253731,
      "link": null,
      "locked": false,
      "text": "• \"BFS가 회차마다 set을 새로 만드는 것과 같은 이유입니다.\"",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• \"BFS가 회차마다 set을 새로 만드는 것과 같은 이유입니다.\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b9l"
    },
