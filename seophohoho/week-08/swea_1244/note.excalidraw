      "isDeleted": false,
      "boundElements": [],
      "updated": 1790752853371,
      "link": null,
      "locked": false,
      "text": "모든 경우를 한 회차씩 펼쳐 보고, 마지막 회차에서 가장 큰 수를 고른다",
      "fontSize": 60,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "모든 경우를 한 회차씩 펼쳐 보고, 마지막 회차에서 가장 큰 수를 고른다",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1D"
    },
