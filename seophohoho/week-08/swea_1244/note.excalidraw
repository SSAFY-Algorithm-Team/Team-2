      "boundElements": [],
      "updated": 1790752846006,
      "link": null,
      "locked": false,
      "text": "앞의 것은 아직 2번 남았고, 뒤의 것은 끝났다",
      "fontSize": 56,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "앞의 것은 아직 2번 남았고, 뒤의 것은 끝났다",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2v"
    },
    {
