      "frameId": null,
      "roundness": null,
      "seed": 2113754379,
      "version": 2,
      "versionNonce": 1063271635,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790752846006,
      "link": null,
      "locked": false,
      "text": "5장 중 2장 고르기 = 5 × 4 ÷ 2 = 10가지",
      "fontSize": 64,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5장 중 2장 고르기 = 5 × 4 ÷ 2 = 10가지",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1f"
    },
    {
      "id": "pUAM9VBy3ixanghu-qn5G",
      "type": "text",
      "x": -210,
      "y": 5070,
      "width": 1300,
      "height": 130,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 500406267,
      "version": 2,
      "versionNonce": 325905885,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790752846006,
      "link": null,
      "locked": false,
      "text": "조합(combination) — 순서 없이 몇 개를 고르는 것\n(1번·3번 = 3번·1번, 한 번만 센다)",
      "fontSize": 52,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "조합(combination) — 순서 없이 몇 개를 고르는 것\n(1번·3번 = 3번·1번, 한 번만 센다)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1g"
    },
